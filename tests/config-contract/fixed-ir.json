{
  "schema_version": 2,
  "appearance": "system",
  "strategy": {
    "debug": false,
    "execution_mode": "parallel",
    "order": [
      "face",
      "fingerprint"
    ],
    "ignore_services": [
      "polkit-1",
      "pkexec"
    ],
    "show_auth_status": true
  },
  "methods": {
    "face": {
      "enable": true,
      "retries": 5,
      "retry_delay": 200,
      "camera": null,
      "detection": {
        "model_id": "yolov8n-face",
        "threshold": 0.5
      },
      "recognition": {
        "model_id": "edgeface-s-gamma-05",
        "threshold": 0.5
      },
      "anti_spoofing": {
        "enable": false,
        "model": {
          "model_id": "mobilenetv3-antispoof",
          "threshold": 0.8
        },
        "ir_camera": "/dev/video2",
        "ir_warmup_delay_ms": 300,
        "ir_presence_timeout_ms": 1500
      },
      "camera_selection": {
        "mode": "fixed",
        "fixed_pair": "surface",
        "pairs": [
          {
            "id": "surface",
            "name": "Surface",
            "camera": "libcamera:surface-rgb",
            "ir_camera": "libcamera:surface-ir"
          }
        ]
      }
    },
    "fingerprint": {
      "enable": false,
      "retries": 1,
      "timeout": 5000
    }
  }
}
